        { "logicalName": "ddb_sensitivitylabel", "schemaName": "ddb_SensitivityLabel", "displayName": { "label": "Sensitivity Label" }, "type": "String", "requiredLevel": "None", "maxLength": 200 },
        { "logicalName": "ddb_semanticattributesjson", "schemaName": "ddb_SemanticAttributesJson", "displayName": { "label": "Semantic Attributes JSON" }, "type": "Memo", "requiredLevel": "None", "maxLength": 1048576 },
