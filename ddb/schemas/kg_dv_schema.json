{
  "$schema": "./kg_dv_schema.schema.json",
  "schemaName": "kg_dv_schema",
  "version": "1.0.0",
  "description": "Dataverse-aligned DDB knowledge graph schema for entities, relationships, adaptive cards, agents, sessions, zones, manifests, connectors, workflows, and integration indexes.",
  "publisher": {
    "prefix": "ddb",
    "uniqueName": "DarbotDB",
    "displayName": "DarbotDB"
  },
  "solution": {
    "uniqueName": "ddb_knowledge_graph",
    "displayName": "DDB Knowledge Graph",
    "version": "1.0.0.0",
    "managed": false
  },
  "choices": [
    {
      "name": "ddb_kgcardtype",
      "options": [
        { "value": 100000000, "label": { "label": "Memory" } },
        { "value": 100000001, "label": { "label": "Task" } },
        { "value": 100000002, "label": { "label": "Observation" } },
        { "value": 100000003, "label": { "label": "Pattern" } },
        { "value": 100000004, "label": { "label": "Index" } }
      ]
    },
    {
      "name": "ddb_kgrelationshiptype",
      "options": [
        { "value": 100000000, "label": { "label": "Related To" } },
        { "value": 100000001, "label": { "label": "Derived From" } },
        { "value": 100000002, "label": { "label": "Depends On" } },
        { "value": 100000003, "label": { "label": "Member Of" } },
        { "value": 100000004, "label": { "label": "Routed To" } },
        { "value": 100000005, "label": { "label": "Evidence For" } },
        { "value": 100000006, "label": { "label": "Semantically Similar To" } },
        { "value": 100000007, "label": { "label": "Conflicts With" } },
        { "value": 100000008, "label": { "label": "Supersedes" } }
      ]
    }
  ],
  "semanticAttributes": [
    {
      "name": "ddb_confidence",
      "displayName": { "label": "Confidence" },
      "description": "Normalized confidence score used by agents, relationships, cards, and workflows.",
      "category": "confidence",
      "dataType": "number",
      "appliesTo": ["ddb_kgentity", "ddb_kgrelationship", "ddb_adaptivecard", "ddb_workflow"],
      "indexed": true,
      "metadataPath": "$.confidence"
    },
    {
      "name": "ddb_provenancejson",
      "displayName": { "label": "Provenance JSON" },
      "description": "Source, model, timestamp, observation, and hash metadata for traceable graph facts.",
      "category": "provenance",
      "dataType": "json",
      "appliesTo": ["ddb_kgentity", "ddb_kgrelationship", "ddb_adaptivecard", "ddb_session", "ddb_workflow"],
      "metadataPath": "$.provenance"
    },
    {
      "name": "ddb_lineagejson",
      "displayName": { "label": "Lineage JSON" },
      "description": "Transformation and agent/tool step history for graph records.",
      "category": "lineage",
      "dataType": "json",
      "appliesTo": ["ddb_kgentity", "ddb_kgrelationship", "ddb_adaptivecard", "ddb_integrationindex"],
      "metadataPath": "$.lineage"
    },
    {
      "name": "ddb_semanticattributesjson",
      "displayName": { "label": "Semantic Attributes JSON" },
      "description": "Relatable attributes for semantic lookup, graph projection, and adaptive agent routing.",
      "category": "relationship",
      "dataType": "json",
      "appliesTo": ["ddb_kgentity", "ddb_adaptivecard", "ddb_agentconfig", "ddb_connector"],
      "indexed": true,
      "metadataPath": "$.semanticAttributes"
    },
    {
      "name": "ddb_sensitivitylabel",
      "displayName": { "label": "Sensitivity Label" },
      "description": "Optional information protection or governance label.",
      "category": "classification",
      "dataType": "string",
      "appliesTo": ["ddb_kgentity", "ddb_adaptivecard", "ddb_session"],
      "indexed": true,
      "metadataPath": "$.sensitivity"
    }
  ],
  "relationshipPatterns": [
    {
      "name": "document_to_entity_evidence",
      "displayName": { "label": "Document to Entity Evidence" },
      "sourceTable": "ddb_adaptivecard",
      "targetTable": "ddb_kgentity",
      "relationshipType": "Evidence For",
      "pathPattern": "adaptive-card->evidence->entity",
      "confidenceColumn": "ddb_confidence",
      "metadataColumns": ["ddb_provenancejson", "ddb_semanticattributesjson"]
    },
    {
      "name": "entity_semantic_similarity",
      "displayName": { "label": "Entity Semantic Similarity" },
      "sourceTable": "ddb_kgentity",
      "targetTable": "ddb_kgentity",
      "relationshipType": "Semantically Similar To",
      "pathPattern": "entity->embedding->nearest-entity",
      "reciprocalName": "entity_semantic_similarity",
      "confidenceColumn": "ddb_confidence",
      "metadataColumns": ["ddb_vectorref", "ddb_lineagejson"]
    },
    {
      "name": "workflow_connector_index",
      "displayName": { "label": "Workflow Connector Index" },
      "sourceTable": "ddb_workflow",
      "targetTable": "ddb_integrationindex",
      "relationshipType": "Depends On",
      "pathPattern": "workflow->connector->integration-index",
      "metadataColumns": ["ddb_definitionjson", "ddb_indexjson"]
    }
  ],
  "metadataProfiles": [
    {
      "name": "provenance",
      "description": "Source and observation metadata for auditable graph facts.",
      "appliesTo": ["ddb_kgentity", "ddb_kgrelationship", "ddb_adaptivecard"],
      "fields": ["source", "sourceType", "sourceUri", "observedAt", "model", "hash"]
    },
    {
      "name": "semantic-relatability",
      "description": "Attributes that make graph records easy to relate, index, and project across systems.",
      "appliesTo": ["ddb_kgentity", "ddb_adaptivecard", "ddb_connector", "ddb_workflow"],
      "fields": ["aliases", "tags", "topics", "capabilities", "pathPattern", "embeddingRef"]
    },
    {
      "name": "lineage",
      "description": "Agent, tool, workflow, and transformation history.",
      "appliesTo": ["ddb_session", "ddb_workflow", "ddb_integrationindex"],
      "fields": ["agentId", "tool", "workflowKey", "step", "timestamp", "inputHash", "outputHash"]
    }
  ],
